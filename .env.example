# First admin account, created on first start when no admin exists.
# If ADMIN_PASSWORD is omitted a random one is generated and printed once in the server log.
ADMIN_EMAIL="admin@careverified.local"
ADMIN_PASSWORD="change-me-to-a-long-password-1"

# Where the SQLite database and private uploads are stored (default: ./data)
# DATA_DIR="./data"

# APP_URL: The URL where this app is hosted.
APP_URL="MY_APP_URL"

# ---- Payments (leave unset for test mode; test mode is disabled in production) ----
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# ALLOW_SANDBOX_PAYMENTS="false"
# PLATFORM_COMMISSION_PCT="15"
# CONSULT_NOW_FEE="80"

# ---- Care engine ----
# EMERGENCY_NUMBERS='[{"label":"National emergency","number":"999"}]'
# ICE_SERVERS='[{"urls":"stun:stun.cloudflare.com:3478"},{"urls":"turn:your-turn-host:3478","username":"u","credential":"p"}]'

# ---- Clinical records ----
# Key used to sign prescriptions and certificates. If unset, one is generated and stored in the database.
# Set it explicitly in production so signatures survive a database restore.
# RECORD_SIGNING_SECRET=""

# ---- Pharmacy workspace ----
# Two-factor sign-in (authenticator app) is required for pharmacy accounts in production. Set 1 to require it elsewhere, 0 to relax it.
# REQUIRE_PHARMACY_2FA="1"
# Optional: new-prescription alerts are POSTed here as JSON {type, pharmacyId, title, body, recipients[]} so an email/SMS gateway can deliver them.
# No patient details are sent. Leave unset to use in-app alerts only.
# PHARMACY_ALERT_WEBHOOK_URL=""

# ---- Quality ----
# Annual CPD points target shown to practitioners (check your council's rule)
# CPD_ANNUAL_TARGET="20"

# Privacy notice details (PDPA). Shown in the privacy notice; fill in before launch.
# PRIVACY_CONTROLLER_NAME=MedCred Healthcare Network Sdn Bhd
# PRIVACY_CONTACT_EMAIL=
# DATA_HOSTING_COUNTRY=
# DATA_PROCESSORS=            # optional extra names; prefer the admin transfer register (Privacy centre > Admin)
# DPO_NAME=
# RETENTION_YEARS=            # leave unset until counsel confirms the period: nothing is purged while unset
# RETENTION_AUTO_PURGE=false   # true = daily purge of retained records past the retention period

# MMC register API: intentionally OFF. Enable only after a written agreement with the Malaysian Medical Council.
# MMC_API_ENABLED=false
# MMC_API_BASE_URL=
# MMC_API_KEY=
