{
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/for-doctors",
      "destination": "/index.html"
    },
    {
      "source": "/for-pharmacies",
      "destination": "/index.html"
    },
    {
      "source": "/for-clinics",
      "destination": "/index.html"
    }
  ]
}
